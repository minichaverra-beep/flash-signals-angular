# Copia a .env (raíz del proyecto). server/index.js lo carga al arrancar
# sin pisar variables ya definidas en el proceso/sistema.

# --- Login de administración (gestión de la Wiki y botones de borrar) ---
# Usuario admin (default: admin)
ADMIN_USER=admin
# Contraseña en claro (default si falta: admin → la API avisa en consola).
ADMIN_PASSWORD=cambia-esta-contraseña
# Alternativa más segura: hash scrypt (tiene prioridad sobre ADMIN_PASSWORD).
# Genera con:  node server/auth.js hash "tu-contraseña"
# ADMIN_PASSWORD_HASH=scrypt$...$...
# Secreto HMAC de los tokens. Si falta se genera y guarda en data/admin-token-secret.
# Cambiarlo invalida todas las sesiones abiertas.
# ADMIN_TOKEN_SECRET=
# Duración de la sesión en horas (default 168 = 7 días).
# ADMIN_TOKEN_TTL_HOURS=168

# --- Historial: contraseña extra para borrar filas / limpiar (modo lock) ---
# HISTORY_UNLOCK_PASSWORD=

# --- API ---
# PORT=3847
# BIND_HOST=127.0.0.1
# CURSOR_TRADING_ROOT=D:\Danilo\Trading\Cursor Trading
